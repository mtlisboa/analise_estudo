DJANGO_SECRET_KEY=troque-esta-chave-em-producao
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Comma-separated HTTPS origins for custom production domains.
DJANGO_CSRF_TRUSTED_ORIGINS=

# MCP server that exposes the AI agent tool over Streamable HTTP.
IA_MCP_SERVER_URL=http://localhost:9000/mcp
IA_MCP_CHAT_TOOL=answer_from_documentation
IA_MCP_TIMEOUT_SECONDS=30
