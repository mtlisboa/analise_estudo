DJANGO_SECRET_KEY=troque-esta-chave-em-producao
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Comma-separated HTTPS origins for custom production domains.
DJANGO_CSRF_TRUSTED_ORIGINS=

# Optional sysadmin provisioned after database migrations.
DJANGO_SYSADMIN_NAME=Administrador do Sistema
DJANGO_SYSADMIN_LOGIN=sysadmin
DJANGO_SYSADMIN_EMAIL=sysadmin@example.com
DJANGO_SYSADMIN_PASSWORD=troque-por-uma-senha-forte



# Required for real-time notifications across multiple ASGI workers.
# Empty uses an in-memory layer, for single-process local development only.
REDIS_URL=

# Demonstration seed, run by the entrypoint only when DEPLOY_MODE=MOCK.
DEPLOY_MODE=
MOCK_PASSWORD=

# Local email capture. Compose always sends to mailpit:1025 without auth/TLS.
MAILPIT_HTTP_PORT=8025
MAILPIT_SMTP_PORT=1025
DEFAULT_FROM_EMAIL=nao-responda@analise-estudo.test
# For Django running on the host with Mailpit running in Docker:
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=127.0.0.1
EMAIL_PORT=1025
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=False
EMAIL_USE_SSL=False
EMAIL_TIMEOUT=10

# Local LLM served by Ollama (CPU, no GPU required).
OLLAMA_PORT=11434
OLLAMA_MODEL=qwen2.5:0.5b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_TIMEOUT_SECONDS=180
# CPU-only image shared by the server and model initializer (pinned manifest).
OLLAMA_IMAGE=alpine/ollama@sha256:1792cb2cc1b468826119b176a9679cbaab685ee9bd8296633cdcd203ee6d5528

# Total chat deadline, including all model/tool calls.
IA_CHAT_TIMEOUT_SECONDS=240

OLLAMA_KEEP_ALIVE=30m

# ollama (local) or mcp (trusted remote completion service)
RAG_PROVIDER=ollama
RAG_MCP_URL=
RAG_MCP_TOKEN=
RAG_MCP_TOOL=complete
RAG_MCP_TIMEOUT_SECONDS=180
# Optional public HTTPS URL reachable by the remote service, ending /mcp/questions
RAG_QUESTIONS_MCP_URL=

# Persistence adapter used by the RAG module
RAG_REPOSITORY_CLASS=features.rag.infrastructure.repository.DjangoRepository
